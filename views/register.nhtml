@model(titre: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#FF5A36">
  <title>@titre</title>
  <meta name="description" content="Créez votre compte Noliae pour accéder à Search, IA et vos services.">
  <meta name="robots" content="noindex,nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600&family=Plus+Jakarta+Sans:wght@@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/noliae.css">
</head>
<body>
  <main class="registration-shell">
    <aside class="welcome-panel" aria-label="Présentation Noliae">
      <a class="brand" href="https://noliae.com" aria-label="Noliae, accueil">
        <svg viewBox="0 0 140 100" aria-hidden="true"><rect x="12" y="35" width="10" height="30" rx="5"/><rect x="30" y="25" width="10" height="50" rx="5"/><rect x="48" y="15" width="10" height="70" rx="5"/><rect class="pulse" x="66" y="22" width="10" height="56" rx="5"/><rect x="84" y="20" width="10" height="60" rx="5"/><rect x="102" y="30" width="10" height="40" rx="5"/><rect x="120" y="35" width="10" height="30" rx="5"/></svg>
        <span>noliae</span>
      </a>
      <div class="welcome-copy">
        <p class="eyebrow">Votre espace Noliae</p>
        <h1>Bienvenue<br>chez Noliae.</h1>
        <p>Un compte unique pour Search, IA et les services qui composent votre quotidien.</p>
        <div class="features">
          <article><span class="feature-icon">✦</span><span><b>Un accès unifié</b><small>Votre session suit vos services Noliae.</small></span></article>
          <article><span class="feature-icon">⌁</span><span><b>Vos données, vos règles</b><small>Permissions et sécurité gérées par NolCore.</small></span></article>
          <article><span class="feature-icon">◌</span><span><b>Prêt pour la suite</b><small>Commencez simplement, sans engagement.</small></span></article>
        </div>
      </div>
      <p class="panel-note"><i></i> Session sécurisée par NolCore</p>
    </aside>
    <section class="form-panel">
      <header class="form-top"><span class="step"><b>1</b> Votre compte</span><p>Déjà membre ? <a href="https://login.noliae.com">Se connecter <span>→</span></a></p></header>
      <div class="form-stage">
        <div class="form-heading"><p class="eyebrow">Créer un compte</p><h2>On fait connaissance.</h2><p>Quelques informations suffisent pour démarrer.</p></div>
        <form action="/v1/user/register" method="post">
          <label>Nom complet<input name="name" autocomplete="name" placeholder="Votre nom" required></label>
          <label>Adresse e-mail<input type="email" name="email" autocomplete="email" placeholder="vous@@example.com" required></label>
          <label>Mot de passe<input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="8 caractères minimum" required></label>
          <p class="form-notice">En créant votre compte, vous acceptez les conditions d’utilisation de Noliae.</p>
          <button type="submit">Créer mon compte <span>→</span></button>
        </form>
        <p class="mobile-login">Déjà membre ? <a href="https://login.noliae.com">Se connecter</a></p>
      </div>
      <footer class="form-footer"><span>© Noliae</span><span>Chiffrement et sessions sécurisées</span></footer>
    </section>
  </main>
</body>
</html>
