@model(titre: Text)
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@titre</title><meta name="description" content="Créer un compte Noliae."><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="/static/noliae.css"></head><body><header><a href="/" class="brand">▂▅█▇█▅▂ <span>noliae</span></a><p>Vous avez déjà un compte ? <a href="https://login.noliae.com">Se connecter →</a></p></header><main><section class="intro"><p class="cap"><i></i> Noliae compte</p><h1>Commencez<br>par <em>vous.</em></h1><p>Un seul compte pour Search, IA et les services Noliae.</p><ul><li>Sessions sécurisées par NolCore</li><li>Vos données restent sous votre contrôle</li><li>Connexion sur tous les sous-domaines Noliae</li></ul></section><section class="card"><p class="cap">Créer un compte</p><h2>Bienvenue.</h2><form action="/v1/user/register" method="post"><label>Nom<input name="name" autocomplete="name" required></label><label>Adresse e-mail<input type="email" name="email" autocomplete="email" required></label><label>Mot de passe<input type="password" name="password" autocomplete="new-password" minlength="8" required></label><p class="notice">En continuant, vous acceptez les conditions de Noliae.</p><button>Créer mon compte <b>→</b></button></form><p class="switch">Déjà inscrit ? <a href="https://login.noliae.com">Se connecter</a></p></section></main><footer>© Noliae · Authentification sécurisée</footer></body></html>
