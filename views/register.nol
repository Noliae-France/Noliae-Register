fn vue_register(titre: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#FF5A36\">\n  <title>"
    _o += html_escape(titre)
    _o += "</title>\n  <meta name=\"description\" content=\"Créez votre compte Noliae pour accéder à Search, IA et vos services.\">\n  <meta name=\"robots\" content=\"noindex,nofollow\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n</head>\n<body>\n  <main class=\"registration-shell\">\n    <aside class=\"welcome-panel\" aria-label=\"Présentation Noliae\">\n      <a class=\"brand\" href=\"https://noliae.com\" aria-label=\"Noliae, accueil\">\n        <svg viewBox=\"0 0 140 100\" aria-hidden=\"true\"><rect x=\"12\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/><rect x=\"30\" y=\"25\" width=\"10\" height=\"50\" rx=\"5\"/><rect x=\"48\" y=\"15\" width=\"10\" height=\"70\" rx=\"5\"/><rect class=\"pulse\" x=\"66\" y=\"22\" width=\"10\" height=\"56\" rx=\"5\"/><rect x=\"84\" y=\"20\" width=\"10\" height=\"60\" rx=\"5\"/><rect x=\"102\" y=\"30\" width=\"10\" height=\"40\" rx=\"5\"/><rect x=\"120\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/></svg>\n        <span>noliae</span>\n      </a>\n      <div class=\"welcome-copy\">\n        <p class=\"eyebrow\">Votre espace Noliae</p>\n        <h1>Bienvenue<br>chez Noliae.</h1>\n        <p>Un compte unique pour Search, IA et les services qui composent votre quotidien.</p>\n        <div class=\"features\">\n          <article><span class=\"feature-icon\">✦</span><span><b>Un accès unifié</b><small>Votre session suit vos services Noliae.</small></span></article>\n          <article><span class=\"feature-icon\">⌁</span><span><b>Vos données, vos règles</b><small>Permissions et sécurité gérées par NolCore.</small></span></article>\n          <article><span class=\"feature-icon\">◌</span><span><b>Prêt pour la suite</b><small>Commencez simplement, sans engagement.</small></span></article>\n        </div>\n      </div>\n      <p class=\"panel-note\"><i></i> Session sécurisée par NolCore</p>\n    </aside>\n    <section class=\"form-panel\">\n      <header class=\"form-top\"><span class=\"step\"><b>1</b> Votre compte</span><p>Déjà membre ? <a href=\"https://login.noliae.com\">Se connecter <span>→</span></a></p></header>\n      <div class=\"form-stage\">\n        <div class=\"form-heading\"><p class=\"eyebrow\">Créer un compte</p><h2>On fait connaissance.</h2><p>Quelques informations suffisent pour démarrer.</p></div>\n        <form action=\"/v1/user/register\" method=\"post\">\n          <label>Nom complet<input name=\"name\" autocomplete=\"name\" placeholder=\"Votre nom\" required></label>\n          <label>Adresse e-mail<input type=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"vous@example.com\" required></label>\n          <label>Mot de passe<input type=\"password\" name=\"password\" autocomplete=\"new-password\" minlength=\"8\" placeholder=\"8 caractères minimum\" required></label>\n          <p class=\"form-notice\">En créant votre compte, vous acceptez les conditions d’utilisation de Noliae.</p>\n          <button type=\"submit\">Créer mon compte <span>→</span></button>\n        </form>\n        <p class=\"mobile-login\">Déjà membre ? <a href=\"https://login.noliae.com\">Se connecter</a></p>\n      </div>\n      <footer class=\"form-footer\"><span>© Noliae</span><span>Chiffrement et sessions sécurisées</span></footer>\n    </section>\n  </main>\n</body>\n</html>\n"
    return _o
}
