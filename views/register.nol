fn vue_register(titre: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#FF5A36\">\n  <title>"
    _o += html_escape(titre)
    _o += "</title>\n  <meta name=\"description\" content=\"Créez votre compte Noliae pour accéder à Search, IA et vos services.\">\n  <meta name=\"robots\" content=\"noindex,nofollow\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/static/noliae.css\">\n  <style>.brand img{width:42px;height:30px;object-fit:contain}.welcome-copy h1 [data-brand-name]{color:var(--pulse-ink)}</style>\n</head>\n<body>\n  <main class=\"registration-shell\">\n    <aside class=\"welcome-panel\" aria-label=\"Présentation de l’instance\">\n      <a class=\"brand\" href=\"/\" aria-label=\"Accueil\">\n        <img id=\"brand-logo\" alt=\"\" hidden>\n        <span data-brand-name>NolCore</span>\n      </a>\n      <div class=\"welcome-copy\">\n        <p class=\"eyebrow\">Votre espace</p>\n        <h1>Bienvenue<br>chez <span data-brand-name>NolCore</span>.</h1>\n        <p>Un compte unique pour vos services et vos espaces connectés.</p>\n        <div class=\"features\">\n          <article><span class=\"feature-icon\">✦</span><span><b>Un accès unifié</b><small>Votre session suit vos services configurés.</small></span></article>\n          <article><span class=\"feature-icon\">⌁</span><span><b>Vos données, vos règles</b><small>Permissions et sécurité gérées par NolCore.</small></span></article>\n          <article><span class=\"feature-icon\">◌</span><span><b>Prêt pour la suite</b><small>Commencez simplement, sans engagement.</small></span></article>\n        </div>\n      </div>\n      <p class=\"panel-note\"><i></i> Session sécurisée par NolCore</p>\n    </aside>\n    <section class=\"form-panel\">\n      <header class=\"form-top\"><span class=\"step\"><b>1</b> Votre compte</span><p>Déjà membre ? <a data-url=\"login_url\" href=\"/\">Se connecter <span>→</span></a></p></header>\n      <div class=\"form-stage\">\n        <div class=\"form-heading\"><p class=\"eyebrow\">Créer un compte</p><h2>On fait connaissance.</h2><p>Quelques informations suffisent pour démarrer.</p></div>\n        <form id=\"register-form\" novalidate>\n          <label>Nom complet<input name=\"name\" autocomplete=\"name\" placeholder=\"Votre nom\" required></label>\n          <label>Adresse e-mail<input type=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"vous@example.com\" required></label>\n          <label>Mot de passe<input type=\"password\" name=\"password\" autocomplete=\"new-password\" minlength=\"8\" placeholder=\"8 caractères minimum\" required></label>\n          <p class=\"form-notice\">En créant votre compte, vous acceptez les conditions d’utilisation de cette instance.</p>\n          <button type=\"submit\">Créer mon compte <span>→</span></button>\n        </form>\n        <p id=\"form-status\" class=\"form-status\" role=\"status\" aria-live=\"polite\"></p>\n        <p class=\"mobile-login\">Déjà membre ? <a data-url=\"login_url\" href=\"/\">Se connecter</a></p>\n      </div>\n      <footer class=\"form-footer\"><span>© <span data-brand-name>NolCore</span></span><span>Chiffrement et sessions sécurisées</span></footer>\n    </section>\n  </main>\n  <script>\n    const form = document.getElementById(\"register-form\");\n    const status = document.getElementById(\"form-status\");\n    const apiOrigin = () => {\n      const host = window.location.hostname;\n      if (host.startsWith(\"register.\")) return window.location.protocol + \"//api.\" + host.slice(9);\n      return window.location.origin;\n    };\n    const loadBranding = async () => {\n      try {\n        const response = await fetch(apiOrigin() + \"/v1/branding\");\n        if (!response.ok) return;\n        const brand = await response.json();\n        const name = brand.name || \"NolCore\";\n        document.querySelectorAll(\"[data-brand-name]\").forEach((node) => node.textContent = name);\n        document.title = \"Créer un compte — \" + name;\n        if (brand.website_url) document.querySelector(\".brand\").href = brand.website_url;\n        document.querySelectorAll(\"[data-url]\").forEach((link) => {\n          const url = brand[link.dataset.url];\n          if (url) link.href = url;\n        });\n        if (brand.logo_url) {\n          const logo = document.getElementById(\"brand-logo\");\n          logo.src = brand.logo_url;\n          logo.hidden = false;\n        }\n      } catch (_) { /* repli neutre : NolCore */ }\n    };\n    loadBranding();\n    form.addEventListener(\"submit\", async (event) => {\n      event.preventDefault();\n      if (!form.reportValidity()) return;\n      const button = form.querySelector(\"button[type=submit]\");\n      button.disabled = true;\n      status.textContent = \"Création sécurisée de votre compte…\";\n      try {\n        const response = await fetch(apiOrigin() + \"/v1/user/register\", {\n          method: \"POST\", credentials: \"include\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify(Object.fromEntries(new FormData(form)))\n        });\n        const payload = await response.json();\n        if (!response.ok) throw new Error(payload.detail || \"Impossible de créer le compte.\");\n        status.className = \"form-status success\";\n        status.textContent = \"Compte créé. Vérifiez votre e-mail avant de vous connecter.\";\n      } catch (error) {\n        status.className = \"form-status error\";\n        status.textContent = error.message || \"Une erreur est survenue. Réessayez.\";\n        button.disabled = false;\n      }\n    });\n  </script>\n<script src=\"/static/links.js\"></script></body>\n</html>\n"
    return _o
}
